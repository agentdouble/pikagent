{
  "name": "pickagent",
  "version": "1.0.0",
  "description": "pickagent terminal workspace manager with split panels",
  "main": "main.js",
  "productName": "Pickagent",
  "scripts": {
    "build": "node build.js",
    "start": "node build.js && electron .",
    "dev": "node scripts/dev.js",
    "hook": "node bin/pickagent-hook.cjs",
    "rebuild": "npx @electron/rebuild",
    "package": "npm run build && electron-builder --mac dir",
    "package:dmg": "npm run build && electron-builder --mac dmg zip",
    "release:mac": "npm run build && electron-builder --mac dmg zip --publish always",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bin": {
    "pickagent-hook": "bin/pickagent-hook.cjs"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "electron": "^41.0.3",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.27.4",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.3",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.1",
    "node-pty": "^1.1.0"
  },
  "build": {
    "appId": "com.rekta.pickagent",
    "productName": "Pickagent",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "api-schema.js",
      "main/**/*",
      "shared/**/*",
      "bin/**/*",
      "src/**/*",
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "agentdouble",
        "repo": "pikagent",
        "releaseType": "release"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "icon": "assets/icon.icns",
      "notarize": true,
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
